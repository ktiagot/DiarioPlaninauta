generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BACKER
  PREMIUM
  VIP
}

// Hub relacional do portal.
// Outras tabelas devem referenciar User via:
//   userId String
//   user   User   @relation(fields: [userId], references: [id])
//   @@index([userId])
// E no User: <nomeRelacao> ExemploEntidade[]
model User {
  id        String @id @default(uuid())
  email     String @unique

  // --- mandatory registration fields ---
  nome         String
  sobrenome    String
  nick         String @unique
  telefone     String
  formatos     String[] @default([])
  cidade       String
  estado       String?
  pais         String?
  lat          Float?
  lng          Float?
  passwordHash String

  // --- role flags ---
  isAdmin         Boolean @default(false)
  isExApoiador    Boolean @default(false)
  isApoiadorAtivo Boolean @default(false)

  // --- optional profile fields ---
  token              String?
  foto               String?
  genero             String?
  tier               String?
  badge              String?
  formatoFavorito    String?
  diasDisponiveis    String[]  @default([])
  horarios           String[]  @default([])
  partidas           Int?
  vitorias           Int?
  eliminacoes        Int?
  winRate            Float?
  pontosTotais       Float?
  melhoresResultados Int[]     @default([])
  preCampeonatos     String[]  @default([])
  decksMaisUsados    String[]  @default([])

  // --- auth / APOIA.se fields ---
  role                UserRole @default(BACKER)
  monthlyContribution Int?
  lastValidationAt    DateTime?
  apoiandoDesde       DateTime?

  // --- comunidade / favoritos ---
  favoritosDe   Favorito[] @relation("FavoritoDe")
  favoritosPara Favorito[] @relation("FavoritoPara")

  // --- mesas relations ---
  mesasCriadas       Mesa[]        @relation("MesaCriador")
  mesaJogadores      MesaJogador[] @relation("MesaJogadorUser")
  eliminacoesFeitas  Eliminacao[]  @relation("EliminacaoEliminador")
  eliminacoesSofridas Eliminacao[] @relation("EliminacaoEliminado")

  // --- precompeonato ---
  inscricoes Inscricao[]

  // --- loja de pontos ---
  resgates Resgate[]
  pontos   Ponto[]

  // --- notificações ---
  notificacoes Notificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum CampeonatoStatus {
  INSCRICOES_ABERTAS
  EM_ANDAMENTO
  ENCERRADO
}

model Precon {
  id            String  @id @default(uuid())
  nome          String
  setNome       String
  ano           Int
  banido        Boolean @default(false)
  isPartnerDeck Boolean @default(false)
  deckUrl       String?

  comandantes   PreconComandante[]
  inscricoes    Inscricao[]
  mesaJogadores MesaJogador[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("precons")
}

model PreconComandante {
  id            String  @id @default(uuid())
  preconId      String
  comandante    String
  ordem         Int     @default(1)
  colorIdentity String  @default("") // ex: "WUBRG" (ordenado); "" = incolor
  isPartner     Boolean @default(false)
  isPrincipal   Boolean @default(false)

  precon             Precon        @relation(fields: [preconId], references: [id], onDelete: Cascade)
  inscricoes         Inscricao[]   @relation("InscricaoComandante")
  inscricoesParceiro Inscricao[]   @relation("InscricaoComandante2")
  mesaJogadores      MesaJogador[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([preconId, comandante])
  @@index([preconId])
  @@map("precon_comandantes")
}

model Campeonato {
  id                   String           @id @default(uuid())
  nome                 String
  edicao               String
  dataInicio           DateTime         @db.Date
  descricao            String?
  bannerUrl            String?
  status               CampeonatoStatus @default(INSCRICOES_ABERTAS)
  inscricoesAbertasAte DateTime?

  inscricoes Inscricao[]
  rodadas    Rodada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campeonatos")
}

model Inscricao {
  id                String    @id @default(uuid())
  campeonatoId      String
  userId            String
  email             String
  discordNick       String
  deckUrl             String?
  preconId            String
  preconComandanteId  String
  preconComandante2Id String?
  aceiteTermos        Boolean
  aceiteTermosEm    DateTime
  aceitePrivacidade Boolean
  entrouDiscord     Boolean
  ativo             Boolean   @default(true)
  pontos            Int       @default(0)
  posicao           Int?

  campeonato       Campeonato       @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  precon            Precon            @relation(fields: [preconId], references: [id], onDelete: Restrict)
  preconComandante  PreconComandante  @relation("InscricaoComandante", fields: [preconComandanteId], references: [id], onDelete: Restrict)
  preconComandante2 PreconComandante? @relation("InscricaoComandante2", fields: [preconComandante2Id], references: [id], onDelete: Restrict)
  mesas             MesaTorneioJogador[]
  checkIns          CheckInRodada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campeonatoId, userId])
  @@index([campeonatoId])
  @@index([userId])
  @@index([email])
  @@index([preconId])
  @@index([preconComandanteId])
  @@index([preconComandante2Id])
  @@map("inscricoes")
}

model Rodada {
  id           String   @id @default(uuid())
  campeonatoId String
  numero       Int
  ativa        Boolean  @default(false)
  finalizada   Boolean  @default(false)
  dataRodada   DateTime @db.Date

  campeonato Campeonato      @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  mesas      MesaTorneio[]
  checkIns   CheckInRodada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campeonatoId, numero])
  @@index([campeonatoId])
  @@map("rodadas")
}

model CheckInRodada {
  id          String   @id @default(uuid())
  rodadaId    String
  inscricaoId String
  createdAt   DateTime @default(now())

  rodada    Rodada    @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  inscricao Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@unique([rodadaId, inscricaoId])
  @@index([rodadaId])
  @@index([inscricaoId])
  @@map("checkins_rodada")
}

model MesaTorneio {
  id                    String    @id @default(uuid())
  rodadaId              String
  numeroMesa            Int
  linkPartida           String?
  empate                Boolean   @default(false)
  empatadosInscricaoIds String[]  @default([])
  validada              Boolean   @default(false)
  validadaEm            DateTime?

  rodada    Rodada               @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  jogadores MesaTorneioJogador[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rodadaId, numeroMesa])
  @@index([rodadaId])
  @@map("mesas_torneio")
}

model MesaTorneioJogador {
  id           String @id @default(uuid())
  mesaId       String
  inscricaoId  String
  posicaoFinal Int?
  kills        Int    @default(0)

  mesa      MesaTorneio @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  inscricao Inscricao   @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mesaId, inscricaoId])
  @@index([mesaId])
  @@index([inscricaoId])
  @@map("mesa_torneio_jogadores")
}

model Mesa {
  id            String   @id @default(uuid())
  nome          String
  descricao     String?
  dataHora      DateTime
  linkPartida   String?
  finalizada    Boolean  @default(false)
  finalizadaEm  DateTime?
  criadorUserId String?

  jogadores    MesaJogador[]
  eliminacoes  Eliminacao[]
  criador      User?         @relation("MesaCriador", fields: [criadorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([criadorUserId])
  @@map("mesas")
}

model MesaJogador {
  id                 String  @id @default(uuid())
  mesaId             String
  userId             String
  preconId           String?
  preconComandanteId String?
  posicaoFinal       Int?
  kills              Int     @default(0)

  mesa             Mesa              @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  user             User              @relation("MesaJogadorUser", fields: [userId], references: [id], onDelete: Restrict)
  precon           Precon?           @relation(fields: [preconId], references: [id], onDelete: Restrict)
  preconComandante PreconComandante? @relation(fields: [preconComandanteId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mesaId, userId])
  @@index([mesaId])
  @@index([userId])
  @@index([preconId])
  @@index([preconComandanteId])
  @@map("mesa_jogadores")
}

model Eliminacao {
  id                String @id @default(uuid())
  mesaId            String
  eliminadorUserId  String
  eliminadoUserId   String

  mesa       Mesa @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  eliminador User @relation("EliminacaoEliminador", fields: [eliminadorUserId], references: [id], onDelete: Restrict)
  eliminado  User @relation("EliminacaoEliminado", fields: [eliminadoUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([mesaId, eliminadoUserId])
  @@index([mesaId])
  @@map("eliminacoes")
}

model Favorito {
  id          String   @id @default(uuid())
  deUserId    String
  paraUserId  String
  createdAt   DateTime @default(now())

  deUser   User @relation("FavoritoDe", fields: [deUserId], references: [id], onDelete: Cascade)
  paraUser User @relation("FavoritoPara", fields: [paraUserId], references: [id], onDelete: Cascade)

  @@unique([deUserId, paraUserId])
  @@index([deUserId])
  @@index([paraUserId])
  @@map("favoritos")
}

// =============================================
// LOJA DE PONTOS
// =============================================

model Produto {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  precoPontos Int
  imagemUrl   String?
  estoque     Int?     // null = ilimitado
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resgates Resgate[]

  @@map("produtos")
}

model Resgate {
  id           String   @id @default(uuid())
  userId       String
  produtoId    String
  pontosGastos Int
  status       String   @default("pendente") // pendente, aprovado, entregue, cancelado
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([userId])
  @@map("resgates")
}

model Ponto {
  id             String   @id @default(uuid())
  userId         String
  tipo           String   // credito, debito
  quantidade     Int
  descricao      String
  referenciaTipo String?  // campeonato, mesa_casual, loja, manual
  referenciaId   String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pontos")
}


// =============================================
// NOTIFICAÇÕES
// =============================================

model Notificacao {
  id        String   @id @default(uuid())
  userId    String
  tipo      String   // rodada_nova, resultado_publicado, favorito_mutuo, pontos_creditados, geral
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
  @@map("notificacoes")
}
