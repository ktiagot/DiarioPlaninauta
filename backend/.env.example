PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/diarioplaninauta"

JWT_SECRET=troque_por_uma_string_secreta_longa
JWT_EXPIRES=15m
REFRESH_EXPIRES=30d

FRONTEND_URL=http://localhost:4200

# APOIA.se — solicitar em suporte@apoia.se
# true = não chama a API; qualquer e-mail vira apoiador ativo (só para desenvolvimento)
APOIASE_MOCK=true
APOIASE_URL=https://api.apoia.se
APOIASE_API_KEY=sua_chave_aqui
APOIASE_SECRET=seu_segredo_jwt_aqui

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app
